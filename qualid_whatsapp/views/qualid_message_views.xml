<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="qualid_message_view_tree" model="ir.ui.view">
        <field name="name">qualid.whatsapp.message.tree</field>
        <field name="model">qualid.whatsapp.message</field>
        <field name="arch" type="xml">
            <tree string="WhatsApp Messages" create="false" edit="false"
                  decoration-success="state == 'sent'" decoration-danger="state == 'failed'"
                  decoration-muted="state == 'cancel'" decoration-warning="state == 'queued'">
                <field name="create_date" string="Date"/>
                <field name="record_name"/>
                <field name="res_model" optional="hide"/>
                <field name="phone"/>
                <field name="template_name"/>
                <field name="template_language" optional="hide"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'sent'" decoration-danger="state == 'failed'"
                       decoration-warning="state == 'queued'"/>
                <field name="attempts" optional="hide"/>
                <field name="error_message" optional="show"/>
            </tree>
        </field>
    </record>

    <record id="qualid_message_view_form" model="ir.ui.view">
        <field name="name">qualid.whatsapp.message.form</field>
        <field name="model">qualid.whatsapp.message</field>
        <field name="arch" type="xml">
            <form string="WhatsApp Message" create="false" edit="false">
                <header>
                    <button name="action_retry" type="object" string="Retry" class="btn-primary"
                            invisible="state not in ('failed', 'cancel')" groups="base.group_system"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state != 'queued'" groups="base.group_system"/>
                    <field name="state" widget="statusbar" statusbar_visible="queued,sent"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_record" type="object" class="oe_stat_button" icon="fa-file-o"
                                invisible="not res_id">
                            <span>Document</span>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="template_name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="record_name"/>
                            <field name="res_model"/>
                            <field name="res_id"/>
                            <field name="phone"/>
                            <field name="template_language"/>
                            <field name="template_id"/>
                        </group>
                        <group>
                            <field name="create_date"/>
                            <field name="sent_date"/>
                            <field name="attempts"/>
                            <field name="next_attempt" invisible="state != 'queued'"/>
                            <field name="wa_message_id"/>
                            <field name="qualid_log_id"/>
                            <field name="action_id"/>
                        </group>
                    </group>
                    <group string="Variables">
                        <field name="header_text"/>
                        <field name="body_params"/>
                        <field name="media_type"/>
                        <field name="media_source" invisible="not media_type"/>
                        <field name="media_report_id" invisible="media_source != 'report'"/>
                        <field name="media_field_name" invisible="media_source not in ('image_field', 'url_field')"/>
                        <field name="media_attachment_filter" invisible="media_source != 'attachment'"/>
                        <field name="media_filename" invisible="not media_filename"/>
                        <field name="media_url" widget="url" invisible="not media_url"/>
                    </group>
                    <group string="Error" invisible="not error_code and not error_message">
                        <field name="error_code"/>
                        <field name="error_message"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="qualid_message_view_search" model="ir.ui.view">
        <field name="name">qualid.whatsapp.message.search</field>
        <field name="model">qualid.whatsapp.message</field>
        <field name="arch" type="xml">
            <search>
                <field name="phone"/>
                <field name="template_name"/>
                <field name="record_name"/>
                <filter name="f_queued" string="Queued" domain="[('state', '=', 'queued')]"/>
                <filter name="f_sent" string="Sent" domain="[('state', '=', 'sent')]"/>
                <filter name="f_failed" string="Failed" domain="[('state', '=', 'failed')]"/>
                <separator/>
                <filter name="f_today" string="Today"
                        domain="[('create_date', '>=', context_today().strftime('%Y-%m-%d'))]"/>
                <group expand="0" string="Group By">
                    <filter name="g_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="g_template" string="Template" context="{'group_by': 'template_name'}"/>
                    <filter name="g_model" string="Document Model" context="{'group_by': 'res_model'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_qualid_message" model="ir.actions.act_window">
        <field name="name">WhatsApp Messages</field>
        <field name="res_model">qualid.whatsapp.message</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No WhatsApp messages sent yet</p>
            <p>Messages sent from automation rules, server actions or the Send wizard appear here.</p>
        </field>
    </record>

    <record id="action_qualid_message_retry" model="ir.actions.server">
        <field name="name">Retry Sending</field>
        <field name="model_id" ref="model_qualid_whatsapp_message"/>
        <field name="binding_model_id" ref="model_qualid_whatsapp_message"/>
        <field name="binding_view_types">list</field>
        <field name="groups_id" eval="[(4, ref('base.group_system'))]"/>
        <field name="state">code</field>
        <field name="code">records.action_retry()</field>
    </record>
</odoo>
