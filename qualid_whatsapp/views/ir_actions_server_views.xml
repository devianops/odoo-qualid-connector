<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Extends the base server action form. base_automation's popup form
        (ir_actions_server_view_form_automation) inherits this view, so the
        fields also appear inside Automation Rules.
    -->
    <record id="qualid_view_server_action_form" model="ir.ui.view">
        <field name="name">ir.actions.server.form.qualid</field>
        <field name="model">ir.actions.server</field>
        <field name="inherit_id" ref="base.view_server_action_form"/>
        <field name="arch" type="xml">
            <!-- Odoo 19: action details live in <t name="action_content">; add ours before the Code/Help tabs -->
            <xpath expr="//t[@name='action_content']/notebook" position="before">
                <div invisible="state != 'qualid_template'" class="o_qualid_action mt-2">
                    <field name="qualid_template_needs_media" invisible="1"/>
                    <field name="qualid_template_has_variables" invisible="1"/>
                    <group>
                        <group>
                            <field name="qualid_template_id"
                                   required="state == 'qualid_template'"
                                   options="{'no_create': True, 'no_open': True}"/>
                            <field name="qualid_phone_path" placeholder="Automatic"/>
                        </group>
                        <group>
                            <field name="qualid_send_mode" widget="radio" options="{'horizontal': true}"/>
                            <field name="qualid_once_per_record"/>
                        </group>
                    </group>
                    <!-- ── Header file (image / video / document templates) ── -->
                    <div invisible="not qualid_template_needs_media" class="o_qualid_media_box mt-3">
                        <div class="o_qualid_media_title">
                            <i class="oi me-1" data-icon="attach_file"/> Header file — this template needs a
                            <b><field name="qualid_template_header_type" readonly="1" class="o_qualid_inline"/></b>
                        </div>
                        <group>
                            <field name="qualid_media_source" widget="radio" string="Take the file from"
                                   options="{'horizontal': true}"
                                   required="state == 'qualid_template' and qualid_template_needs_media"/>
                            <field name="qualid_media_report_id" string="PDF report"
                                   invisible="qualid_media_source != 'report'" required="state == 'qualid_template' and qualid_template_needs_media and qualid_media_source == 'report'"
                                   domain="[('model', '=', model_name), ('report_type', '=', 'qweb-pdf')]"
                                   options="{'no_create': True, 'no_open': True}"
                                   placeholder="e.g. Invoices, Quotation / Order"/>
                            <field name="qualid_media_attachment_filter"
                                   invisible="qualid_media_source != 'attachment'"
                                   placeholder="optional — e.g. result, contract"/>
                            <field name="qualid_media_image_field_id" string="Image field"
                                   invisible="qualid_media_source != 'image_field'" required="state == 'qualid_template' and qualid_template_needs_media and qualid_media_source == 'image_field'"
                                   domain="[('model', '=', model_name), ('ttype', '=', 'binary')]"
                                   options="{'no_create': True, 'no_open': True}"/>
                            <field name="qualid_media_url_field_id" string="Field with the link"
                                   invisible="qualid_media_source != 'url_field'" required="state == 'qualid_template' and qualid_template_needs_media and qualid_media_source == 'url_field'"
                                   domain="[('model', '=', model_name), ('ttype', 'in', ('char', 'text'))]"
                                   options="{'no_create': True, 'no_open': True}"/>
                            <field name="qualid_media_url" string="File link"
                                   invisible="qualid_media_source != 'url'" required="state == 'qualid_template' and qualid_template_needs_media and qualid_media_source == 'url'"
                                   placeholder="https://…"/>
                        </group>
                        <div class="text-muted small">
                            <i class="oi me-1" data-icon="lock"/>Files generated in Odoo (PDFs, attachments, images) are uploaded
                            securely to Quali-D so WhatsApp can deliver them, and stay available in your Quali-D conversation history.
                            Images are converted to JPEG automatically. Limits: images 5 MB, videos 16 MB (MP4), documents 100 MB.
                        </div>
                    </div>
                    <field name="qualid_param_ids" nolabel="1" invisible="not qualid_template_has_variables">
                        <list editable="bottom" create="false" delete="false">
                            <field name="sequence" column_invisible="True"/>
                            <field name="component" readonly="1" force_save="1"/>
                            <field name="placeholder" readonly="1" force_save="1" string="Variable"/>
                            <field name="source"/>
                            <field name="field_path" invisible="source != 'field'"
                                   required="source == 'field'" placeholder="e.g. partner_id.name"/>
                            <field name="text" invisible="source != 'text'"
                                   required="source == 'text'" placeholder="Fixed text"/>
                        </list>
                    </field>
                    <div class="text-muted small" invisible="not qualid_template_has_variables">
                        Use technical field names; follow relations with dots (partner_id.name, user_id.name, amount_total).
                        Manage templates under <b>Quali-D WhatsApp → Templates</b>.
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
