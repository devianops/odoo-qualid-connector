<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_qualid" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.qualid</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Quali-D WhatsApp" string="Quali-D WhatsApp" name="qualid_whatsapp"
                     logo="/qualid_whatsapp/static/description/icon.png" groups="base.group_system">

                    <field name="qualid_connected" invisible="1"/>

                    <!-- ── Brand header ── -->
                    <div class="o_qualid_hero">
                        <div class="o_qualid_hero_main">
                            <img src="/qualid_whatsapp/static/src/img/qualid_logo.png" alt="Quali-D" class="o_qualid_logo"/>
                            <div class="o_qualid_tagline">
                                Send approved WhatsApp templates from any Odoo record or automation rule.
                            </div>
                        </div>
                        <div class="o_qualid_status">
                            <span class="o_qualid_pill o_qualid_pill_ok" invisible="not qualid_connected">
                                <i class="fa fa-check-circle me-1"/>Connected
                            </span>
                            <span class="o_qualid_pill o_qualid_pill_off" invisible="qualid_connected">
                                <i class="fa fa-plug me-1"/>Not connected
                            </span>
                            <div class="o_qualid_account" invisible="not qualid_connected">
                                <field name="qualid_account_email" readonly="1" class="o_qualid_inline"/>
                            </div>
                        </div>
                    </div>

                    <!-- ── Getting started (shown until connected) ── -->
                    <div class="o_qualid_steps" invisible="qualid_connected">
                        <div class="o_qualid_step">
                            <span class="o_qualid_step_num">1</span>
                            <div>
                                <b>Create a token in Quali-D</b>
                                <div class="text-muted">Settings → Odoo Connector → New Token</div>
                            </div>
                        </div>
                        <div class="o_qualid_step">
                            <span class="o_qualid_step_num">2</span>
                            <div>
                                <b>Paste it below and save</b>
                                <div class="text-muted">Your templates are imported automatically</div>
                            </div>
                        </div>
                        <div class="o_qualid_step">
                            <span class="o_qualid_step_num">3</span>
                            <div>
                                <b>Send from Odoo</b>
                                <div class="text-muted">Automation rules, or ⚙ Actions on any contact</div>
                            </div>
                        </div>
                    </div>

                    <block title="Connection" name="qualid_connection">
                        <setting string="Quali-D Token"
                                 help="Paste the token you created in your Quali-D dashboard. Keep it private — you can rotate or revoke it at any time.">
                            <field name="qualid_api_token" password="True" placeholder="odoo_qd_…"/>
                            <div class="o_qualid_actions">
                                <button name="action_qualid_test_connection" type="object"
                                        string="Test Connection" icon="fa-plug" class="btn btn-primary btn-sm o_qualid_btn"/>
                                <a href="https://dashboard.quali-d.com/settings/odoo-connector" target="_blank"
                                   role="button" class="btn btn-link btn-sm">
                                    <i class="fa fa-external-link me-1"/>Get a token
                                </a>
                            </div>
                        </setting>
                    </block>

                    <block title="WhatsApp Templates" name="qualid_templates">
                        <setting string="Approved Templates"
                                 help="Synced from Quali-D automatically when you save your token and every hour.">
                            <div class="o_qualid_stat">
                                <span class="o_qualid_stat_num"><field name="qualid_template_count" readonly="1"/></span>
                                <span class="o_qualid_stat_label">templates ready to use</span>
                            </div>
                            <div class="text-muted small" invisible="not qualid_last_sync">
                                Last synced <field name="qualid_last_sync" readonly="1" class="o_qualid_inline"/>
                            </div>
                            <div class="o_qualid_actions">
                                <button name="action_qualid_sync_templates" type="object"
                                        string="Sync Now" icon="fa-refresh" class="btn btn-secondary btn-sm"/>
                                <button name="%(qualid_whatsapp.action_qualid_template)d" type="action"
                                        string="View Templates" icon="fa-list" class="btn btn-link btn-sm"/>
                            </div>
                        </setting>
                        <setting string="Sent Messages"
                                 help="Every message sent from Odoo, with its delivery status and any error.">
                            <div class="o_qualid_actions">
                                <button name="%(qualid_whatsapp.action_qualid_message)d" type="action"
                                        string="Open Message Log" icon="fa-whatsapp" class="btn btn-link btn-sm"/>
                            </div>
                        </setting>
                    </block>

                    <block title="Files &amp; Privacy" name="qualid_files">
                        <setting string="Images, videos and documents"
                                 help="PDFs, attachments and images sent from Odoo are uploaded securely to Quali-D so WhatsApp can deliver them.">
                            <div class="o_qualid_retention">
                                <i class="fa fa-comments-o me-1"/>Kept with the conversation, so your team can open them later in the Quali-D inbox.
                            </div>
                            <div class="text-muted small mt-1">
                                Not counted toward your Quali-D broadcast media storage.
                                Limits: images 5 MB (converted to JPEG), videos 16 MB (MP4/3GP), documents 100 MB.
                            </div>
                        </setting>
                    </block>

                    <!-- ── Automation guide ── -->
                    <div class="o_qualid_guide">
                        <div class="o_qualid_guide_head">
                            <div>
                                <h3>Send WhatsApp automatically</h3>
                                <div class="text-muted">
                                    An <b>Automation Rule</b> watches for something to happen in Odoo (an invoice is confirmed, a lead is won, a due date arrives…)
                                    and then runs the action <b>Send WhatsApp (Quali-D)</b>. Pick a recipe below and copy its settings.
                                </div>
                            </div>
                            <div class="o_qualid_actions">
                                <button name="%(base_automation.base_automation_act)d" type="action"
                                        string="Open Automation Rules" icon="fa-bolt" class="btn btn-primary btn-sm o_qualid_btn"/>
                                <button name="%(base.action_server_action)d" type="action"
                                        string="Open Server Actions" icon="fa-cogs" class="btn btn-link btn-sm"/>
                            </div>
                        </div>

                        <div class="o_qualid_howto">
                            <div><span class="o_qualid_step_num">1</span>Automation Rules → <b>New</b>. Choose the <b>Model</b> (what the rule watches) and the <b>Trigger</b> (when it fires).</div>
                            <div><span class="o_qualid_step_num">2</span>Optional: fill <b>Apply on</b> to limit which records count (e.g. customer invoices only).</div>
                            <div><span class="o_qualid_step_num">3</span><b>Add an action</b> → Type <b>Send WhatsApp (Quali-D)</b> → choose the template, header file and variables.</div>
                            <div><span class="o_qualid_step_num">4</span>Save, then try it on <b>one</b> record and check <b>Sent Messages</b>.</div>
                        </div>

                        <div class="o_qualid_recipes">
                            <details class="o_qualid_recipe">
                                <summary><i class="fa fa-file-text-o"/>Invoice confirmed → send the invoice PDF<span class="o_qualid_app">Invoicing</span></summary>
                                <table class="table table-sm">
                                    <tr><th>Model</th><td>Journal Entry</td></tr>
                                    <tr><th>Trigger</th><td>State is set to → <b>Posted</b></td></tr>
                                    <tr><th>Apply on</th><td>Type = Customer Invoice <span class="text-muted">(otherwise vendor bills fire too)</span></td></tr>
                                    <tr><th>Template</th><td>One with a <b>Document</b> header</td></tr>
                                    <tr><th>Header file</th><td>PDF of this record → <b>Invoices</b></td></tr>
                                    <tr><th>Variables</th><td><code>partner_id.name</code>, <code>name</code>, <code>amount_total</code>, <code>currency_id.name</code>, <code>invoice_date_due</code></td></tr>
                                </table>
                            </details>

                            <details class="o_qualid_recipe">
                                <summary><i class="fa fa-check-circle-o"/>Invoice paid → thank you / receipt<span class="o_qualid_app">Invoicing</span></summary>
                                <table class="table table-sm">
                                    <tr><th>Model</th><td>Journal Entry</td></tr>
                                    <tr><th>Trigger</th><td><b>On save</b> → When updating: <b>Payment Status</b></td></tr>
                                    <tr><th>Apply on</th><td>Payment Status is in <b>Paid, In Payment</b> · Type = Customer Invoice</td></tr>
                                    <tr><th>Header file</th><td>If the template has a Document header: PDF of this record → <b>Invoices</b> (shows the payment)</td></tr>
                                    <tr><th>Variables</th><td><code>partner_id.name</code>, <code>name</code>, <code>amount_total</code></td></tr>
                                    <tr><th>Tip</th><td>Keep <b>Send Only Once Per Record</b> ticked so partial payments don't send twice.</td></tr>
                                </table>
                            </details>

                            <details class="o_qualid_recipe">
                                <summary><i class="fa fa-bell-o"/>Payment reminder before / after the due date<span class="o_qualid_app">Invoicing</span></summary>
                                <table class="table table-sm">
                                    <tr><th>Model</th><td>Journal Entry</td></tr>
                                    <tr><th>Trigger</th><td><b>Based on date field</b> → Date Field: <b>Due Date</b> · Delay: <b>3 Days</b> (after) or <b>-2 Days</b> (before)</td></tr>
                                    <tr><th>Apply on</th><td>Status = Posted · Payment Status = <b>Not Paid</b> · Type = Customer Invoice</td></tr>
                                    <tr><th>Variables</th><td><code>partner_id.name</code>, <code>name</code>, <code>amount_residual</code> (amount still due), <code>invoice_date_due</code></td></tr>
                                    <tr><th>Note</th><td>Odoo checks date rules every <b>4 hours</b>, so the message goes out within a few hours of the moment, not to the minute.</td></tr>
                                </table>
                            </details>

                            <details class="o_qualid_recipe">
                                <summary><i class="fa fa-shopping-cart"/>Quotation sent / order confirmed<span class="o_qualid_app">Sales</span></summary>
                                <table class="table table-sm">
                                    <tr><th>Model</th><td>Sales Order</td></tr>
                                    <tr><th>Trigger</th><td>State is set to → <b>Sales Order</b> (confirmed) or <b>Quotation Sent</b></td></tr>
                                    <tr><th>Header file</th><td>PDF of this record → <b>Quotation / Order</b></td></tr>
                                    <tr><th>Variables</th><td><code>partner_id.name</code>, <code>name</code>, <code>amount_total</code>, <code>user_id.name</code> (salesperson)</td></tr>
                                </table>
                            </details>

                            <details class="o_qualid_recipe">
                                <summary><i class="fa fa-truck"/>Order shipped / delivered<span class="o_qualid_app">Inventory</span></summary>
                                <table class="table table-sm">
                                    <tr><th>Model</th><td>Transfer</td></tr>
                                    <tr><th>Trigger</th><td>State is set to → <b>Done</b></td></tr>
                                    <tr><th>Apply on</th><td>Type of Operation = <b>Delivery</b> <span class="text-muted">(skips receipts and internal moves)</span></td></tr>
                                    <tr><th>Header file</th><td>PDF of this record → <b>Delivery Slip</b></td></tr>
                                    <tr><th>Variables</th><td><code>partner_id.name</code>, <code>name</code>, <code>origin</code> (the order number)</td></tr>
                                </table>
                            </details>

                            <details class="o_qualid_recipe">
                                <summary><i class="fa fa-handshake-o"/>Lead won / moved to a stage<span class="o_qualid_app">CRM</span></summary>
                                <table class="table table-sm">
                                    <tr><th>Model</th><td>Lead/Opportunity</td></tr>
                                    <tr><th>Trigger</th><td><b>Stage is set to</b> → pick the stage (e.g. Won, Proposition)</td></tr>
                                    <tr><th>Phone</th><td>Automatic — uses the lead's Mobile or Phone</td></tr>
                                    <tr><th>Variables</th><td><code>contact_name</code>, <code>name</code> (opportunity), <code>user_id.name</code> (salesperson)</td></tr>
                                </table>
                            </details>

                            <details class="o_qualid_recipe">
                                <summary><i class="fa fa-user-plus"/>Welcome message for a new contact<span class="o_qualid_app">Contacts</span></summary>
                                <table class="table table-sm">
                                    <tr><th>Model</th><td>Contact</td></tr>
                                    <tr><th>Trigger</th><td><b>On save</b></td></tr>
                                    <tr><th>Apply on</th><td>Mobile is set <span class="text-muted">(and e.g. Tags contains "Customer")</span></td></tr>
                                    <tr><th>Variables</th><td><code>name</code>, <code>company_id.name</code></td></tr>
                                    <tr><th>Tip</th><td>Keep <b>Send Only Once Per Record</b> ticked — the contact gets one welcome, even if edited later.</td></tr>
                                </table>
                            </details>

                            <details class="o_qualid_recipe">
                                <summary><i class="fa fa-shopping-bag"/>Purchase order to a supplier<span class="o_qualid_app">Purchase</span></summary>
                                <table class="table table-sm">
                                    <tr><th>Model</th><td>Purchase Order</td></tr>
                                    <tr><th>Trigger</th><td>State is set to → <b>Purchase Order</b></td></tr>
                                    <tr><th>Header file</th><td>PDF of this record → <b>Purchase Order</b></td></tr>
                                    <tr><th>Variables</th><td><code>partner_id.name</code>, <code>name</code>, <code>date_planned</code></td></tr>
                                </table>
                            </details>

                            <details class="o_qualid_recipe">
                                <summary><i class="fa fa-tasks"/>Task or ticket reaches a stage<span class="o_qualid_app">Project · Helpdesk</span></summary>
                                <table class="table table-sm">
                                    <tr><th>Model</th><td>Task (or Helpdesk Ticket)</td></tr>
                                    <tr><th>Trigger</th><td><b>Stage is set to</b> → e.g. Done / Solved</td></tr>
                                    <tr><th>Phone</th><td>Automatic — uses the customer on the task / ticket</td></tr>
                                    <tr><th>Variables</th><td><code>partner_id.name</code>, <code>name</code>, <code>stage_id.name</code></td></tr>
                                </table>
                            </details>

                            <details class="o_qualid_recipe">
                                <summary><i class="fa fa-hand-pointer-o"/>A button to send by hand, on any record<span class="o_qualid_app">Any app</span></summary>
                                <table class="table table-sm">
                                    <tr><th>Where</th><td><b>Open Server Actions</b> (button above) → New</td></tr>
                                    <tr><th>Setup</th><td>Choose the Model, Type <b>Send WhatsApp (Quali-D)</b>, fill the template like in a rule, save</td></tr>
                                    <tr><th>Then</th><td>Click <b>Create Contextual Action</b>. It appears under <b>⚙ Actions</b> on that model — for one record, or for many selected in a list.</td></tr>
                                    <tr><th>Contacts</th><td>Already built in: ⚙ Actions → <b>Send WhatsApp Template</b></td></tr>
                                </table>
                            </details>
                        </div>

                        <h4>Good to know</h4>
                        <div class="o_qualid_tips">
                            <div class="o_qualid_tip">
                                <b><i class="fa fa-phone me-1"/>Phone number</b>
                                Leave <b>Phone Field</b> empty and the number is found automatically: the record's Mobile, then Phone, then its
                                customer's Mobile / Phone. To use another number, enter its path, e.g. <code>partner_shipping_id.mobile</code>.
                                Numbers without a country code get your token's default country code.
                            </div>
                            <div class="o_qualid_tip">
                                <b><i class="fa fa-code me-1"/>Variables</b>
                                Choose <b>Field</b> and type the field's technical name. Dots follow links:
                                <code>partner_id.name</code> = the customer's name, <code>user_id.name</code> = the salesperson.
                                Choose <b>Fixed text</b> for words that never change. Dates follow the user's language, amounts have 2 decimals,
                                and linked records print their name.
                            </div>
                            <div class="o_qualid_tip">
                                <b><i class="fa fa-search me-1"/>Finding a field's name</b>
                                Turn on <b>developer mode</b> (Settings → Activate the developer mode), then hover any field on a form:
                                the tooltip shows <b>Field: name</b>. That name is what you type.
                            </div>
                            <div class="o_qualid_tip">
                                <b><i class="fa fa-paperclip me-1"/>Header files</b>
                                Templates with an image, video or document header need a file:
                                <b>PDF of this record</b> (invoices, quotations, delivery slips — Document headers),
                                <b>Latest attachment</b> (anything attached in the chatter),
                                <b>Image from this record</b> (contact photo, product image — Image headers),
                                or a <b>link</b> from a field or the same link for everyone.
                            </div>
                            <div class="o_qualid_tip">
                                <b><i class="fa fa-clock-o me-1"/>In background vs. Immediately</b>
                                <b>In background</b> (recommended) never slows down saving, handles hundreds of records at once and retries failures
                                automatically. <b>Immediately</b> sends while the record is saved — fine for single records.
                            </div>
                            <div class="o_qualid_tip">
                                <b><i class="fa fa-filter me-1"/>Avoiding unwanted messages</b>
                                Always narrow the rule with <b>Apply on</b> and keep <b>Send Only Once Per Record</b> ticked.
                                Marketing templates should only go to customers who agreed to receive WhatsApp messages.
                            </div>
                            <div class="o_qualid_tip">
                                <b><i class="fa fa-life-ring me-1"/>Checking what happened</b>
                                Each send leaves a note in the record's chatter. <b>Sent Messages</b> lists every message with its status and the
                                exact error; failed ones can be re-sent with <b>Retry</b>.
                            </div>
                        </div>
                    </div>

                    <div class="o_qualid_footer">
                        Need help? <a href="https://quali-d.com" target="_blank">quali-d.com</a>
                    </div>
                </app>
            </xpath>
        </field>
    </record>

    <record id="action_qualid_settings" model="ir.actions.act_window">
        <field name="name">Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">inline</field>
        <field name="context">{'module': 'qualid_whatsapp', 'bin_size': False}</field>
    </record>
</odoo>
