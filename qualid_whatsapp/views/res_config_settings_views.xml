<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_qualid" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.qualid</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <div class="app_settings_block" data-string="Quali-D WhatsApp" string="Quali-D WhatsApp" data-key="qualid_whatsapp" groups="base.group_system">

                    <field name="qualid_connected" invisible="1"/>
                    <field name="qualid_app_account" invisible="1"/>
                    <field name="qualid_app_sale" invisible="1"/>
                    <field name="qualid_app_stock" invisible="1"/>
                    <field name="qualid_app_crm" invisible="1"/>
                    <field name="qualid_app_purchase" invisible="1"/>
                    <field name="qualid_app_project" invisible="1"/>

                    <!-- ── Brand header ── -->
                    <div class="o_qualid_hero">
                        <div class="o_qualid_hero_main">
                            <img src="/qualid_whatsapp/static/src/img/qualid_logo.png" alt="Quali-D" class="o_qualid_logo"/>
                            <div class="o_qualid_tagline">
                                Send approved WhatsApp templates from any Odoo record or automation rule.
                            </div>
                        </div>
                        <div class="o_qualid_status">
                            <span class="o_qualid_pill o_qualid_pill_ok" attrs="{'invisible': [('qualid_connected', '=', False)]}">
                                <i class="fa fa-check-circle me-1"/>Connected
                            </span>
                            <span class="o_qualid_pill o_qualid_pill_off" attrs="{'invisible': [('qualid_connected', '!=', False)]}">
                                <i class="fa fa-plug me-1"/>Not connected
                            </span>
                            <div class="o_qualid_account" attrs="{'invisible': [('qualid_connected', '=', False)]}">
                                <field name="qualid_account_email" readonly="1" class="o_qualid_inline"/>
                            </div>
                        </div>
                    </div>

                    <!-- ── Getting started (shown until connected) ── -->
                    <div class="o_qualid_steps" attrs="{'invisible': [('qualid_connected', '!=', False)]}">
                        <div class="o_qualid_step">
                            <span class="o_qualid_step_num">1</span>
                            <div>
                                <b>Create a token in Quali-D</b>
                                <div class="text-muted">Settings → Odoo Connector → New Token</div>
                            </div>
                        </div>
                        <div class="o_qualid_step">
                            <span class="o_qualid_step_num">2</span>
                            <div>
                                <b>Paste it below and save</b>
                                <div class="text-muted">Your templates are imported automatically</div>
                            </div>
                        </div>
                        <div class="o_qualid_step">
                            <span class="o_qualid_step_num">3</span>
                            <div>
                                <b>Send from Odoo</b>
                                <div class="text-muted">Automation rules, or ⚙ Actions on any contact</div>
                            </div>
                        </div>
                    </div>

                    <h2>Connection</h2>
                    <div class="row mt16 o_settings_container" name="qualid_connection">
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                            <span class="o_form_label">Quali-D Token</span>
                            <div class="text-muted">Paste the token you created in your Quali-D dashboard. Keep it private — you can rotate or revoke it at any time.</div>
                            <field name="qualid_api_token" password="True" placeholder="odoo_qd_…"/>
                            <div class="o_qualid_actions">
                                <button name="action_qualid_test_connection" type="object"
                                        string="Test Connection" icon="fa-plug" class="btn btn-primary btn-sm o_qualid_btn"/>
                                <a href="https://dashboard.quali-d.com/settings/odoo-connector" target="_blank"
                                   role="button" class="btn btn-link btn-sm">
                                    <i class="fa fa-external-link me-1"/>Get a token
                                </a>
                            </div>
                        </div>
                        </div>
                    </div>

                    <h2>WhatsApp Templates</h2>
                    <div class="row mt16 o_settings_container" name="qualid_templates">
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                            <span class="o_form_label">Approved Templates</span>
                            <div class="text-muted">Synced from Quali-D automatically when you save your token and every hour.</div>
                            <div class="o_qualid_stat">
                                <span class="o_qualid_stat_num"><field name="qualid_template_count" readonly="1"/></span>
                                <span class="o_qualid_stat_label">templates ready to use</span>
                            </div>
                            <div class="text-muted small" attrs="{'invisible': [('qualid_last_sync', '=', False)]}">
                                Last synced <field name="qualid_last_sync" readonly="1" class="o_qualid_inline"/>
                            </div>
                            <div class="o_qualid_actions">
                                <button name="action_qualid_sync_templates" type="object"
                                        string="Sync Now" icon="fa-refresh" class="btn btn-secondary btn-sm"/>
                                <button name="%(qualid_whatsapp.action_qualid_template)d" type="action"
                                        string="View Templates" icon="fa-list" class="btn btn-link btn-sm"/>
                            </div>
                        </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                            <span class="o_form_label">Sent Messages</span>
                            <div class="text-muted">Every message sent from Odoo, with its delivery status and any error.</div>
                            <div class="o_qualid_actions">
                                <button name="%(qualid_whatsapp.action_qualid_message)d" type="action"
                                        string="Open Message Log" icon="fa-whatsapp" class="btn btn-link btn-sm"/>
                            </div>
                        </div>
                        </div>
                    </div>

                    <h2>Files &amp; Privacy</h2>
                    <div class="row mt16 o_settings_container" name="qualid_files">
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                            <span class="o_form_label">Images, videos and documents</span>
                            <div class="text-muted">PDFs, attachments and images sent from Odoo are uploaded securely to Quali-D so WhatsApp can deliver them.</div>
                            <div class="o_qualid_retention">
                                <i class="fa fa-comments-o me-1"/>Kept with the conversation, so your team can open them later in the Quali-D inbox.
                            </div>
                            <div class="text-muted small mt-1">
                                Not counted toward your Quali-D broadcast media storage.
                                Limits: images 5 MB (converted to JPEG), videos 16 MB (MP4/3GP), documents 100 MB.
                            </div>
                        </div>
                        </div>
                    </div>

                    <!-- ── Ready-made automations ── -->
                    <div class="o_qualid_guide">
                        <div class="o_qualid_guide_head">
                            <div>
                                <div class="o_qualid_guide_title" role="heading" aria-level="2">Automations</div>
                                <div class="text-muted">
                                    Send a WhatsApp message automatically when something happens in Odoo.
                                    Choose one below — you pick the template, everything else is set up for you.
                                </div>
                            </div>
                            <div class="o_qualid_actions">
                                <button name="%(qualid_whatsapp.action_qualid_automation_wizard)d" type="action"
                                        string="New Automation" icon="fa-plus" class="btn btn-primary btn-sm o_qualid_btn"/>
                                <button name="%(base_automation.base_automation_act)d" type="action"
                                        string="My Automations" icon="fa-bolt" class="btn btn-link btn-sm"/>
                            </div>
                        </div>

                        <div class="o_qualid_presets">
                            <div class="o_qualid_preset">
                                <i class="fa fa-file-text-o" title="Automation"/>
                                <div class="o_qualid_preset_text">
                                    <b>Invoice confirmed → send the invoice</b>
                                    <span>When a customer invoice is confirmed · invoice PDF attached</span>
                                </div>
                                <button name="%(qualid_whatsapp.action_qualid_automation_wizard)d" type="action" string="Set up"
                                        context="{'default_preset': 'invoice_posted'}" class="btn btn-secondary btn-sm" attrs="{'invisible': [('qualid_app_account', '=', False)]}"/>
                                <span class="o_qualid_needs" attrs="{'invisible': [('qualid_app_account', '!=', False)]}">Install Invoicing</span>
                            </div>
                            <div class="o_qualid_preset">
                                <i class="fa fa-check-circle-o" title="Automation"/>
                                <div class="o_qualid_preset_text">
                                    <b>Invoice paid → thank you</b>
                                    <span>When a customer invoice becomes paid</span>
                                </div>
                                <button name="%(qualid_whatsapp.action_qualid_automation_wizard)d" type="action" string="Set up"
                                        context="{'default_preset': 'invoice_paid'}" class="btn btn-secondary btn-sm" attrs="{'invisible': [('qualid_app_account', '=', False)]}"/>
                                <span class="o_qualid_needs" attrs="{'invisible': [('qualid_app_account', '!=', False)]}">Install Invoicing</span>
                            </div>
                            <div class="o_qualid_preset">
                                <i class="fa fa-bell-o" title="Automation"/>
                                <div class="o_qualid_preset_text">
                                    <b>Payment reminder before the due date</b>
                                    <span>2 days before an unpaid invoice is due</span>
                                </div>
                                <button name="%(qualid_whatsapp.action_qualid_automation_wizard)d" type="action" string="Set up"
                                        context="{'default_preset': 'invoice_due_soon'}" class="btn btn-secondary btn-sm" attrs="{'invisible': [('qualid_app_account', '=', False)]}"/>
                                <span class="o_qualid_needs" attrs="{'invisible': [('qualid_app_account', '!=', False)]}">Install Invoicing</span>
                            </div>
                            <div class="o_qualid_preset">
                                <i class="fa fa-exclamation-circle" title="Automation"/>
                                <div class="o_qualid_preset_text">
                                    <b>Overdue reminder</b>
                                    <span>3 days after the due date if still unpaid</span>
                                </div>
                                <button name="%(qualid_whatsapp.action_qualid_automation_wizard)d" type="action" string="Set up"
                                        context="{'default_preset': 'invoice_overdue'}" class="btn btn-secondary btn-sm" attrs="{'invisible': [('qualid_app_account', '=', False)]}"/>
                                <span class="o_qualid_needs" attrs="{'invisible': [('qualid_app_account', '!=', False)]}">Install Invoicing</span>
                            </div>
                            <div class="o_qualid_preset">
                                <i class="fa fa-paper-plane-o" title="Automation"/>
                                <div class="o_qualid_preset_text">
                                    <b>Quotation sent → send the quotation</b>
                                    <span>When a quotation is marked as sent · PDF attached</span>
                                </div>
                                <button name="%(qualid_whatsapp.action_qualid_automation_wizard)d" type="action" string="Set up"
                                        context="{'default_preset': 'quotation_sent'}" class="btn btn-secondary btn-sm" attrs="{'invisible': [('qualid_app_sale', '=', False)]}"/>
                                <span class="o_qualid_needs" attrs="{'invisible': [('qualid_app_sale', '!=', False)]}">Install Sales</span>
                            </div>
                            <div class="o_qualid_preset">
                                <i class="fa fa-shopping-cart" title="Automation"/>
                                <div class="o_qualid_preset_text">
                                    <b>Order confirmed → send the order</b>
                                    <span>When a quotation is confirmed · PDF attached</span>
                                </div>
                                <button name="%(qualid_whatsapp.action_qualid_automation_wizard)d" type="action" string="Set up"
                                        context="{'default_preset': 'order_confirmed'}" class="btn btn-secondary btn-sm" attrs="{'invisible': [('qualid_app_sale', '=', False)]}"/>
                                <span class="o_qualid_needs" attrs="{'invisible': [('qualid_app_sale', '!=', False)]}">Install Sales</span>
                            </div>
                            <div class="o_qualid_preset">
                                <i class="fa fa-truck" title="Automation"/>
                                <div class="o_qualid_preset_text">
                                    <b>Order delivered → delivery slip</b>
                                    <span>When a customer delivery is validated · PDF attached</span>
                                </div>
                                <button name="%(qualid_whatsapp.action_qualid_automation_wizard)d" type="action" string="Set up"
                                        context="{'default_preset': 'delivery_done'}" class="btn btn-secondary btn-sm" attrs="{'invisible': [('qualid_app_stock', '=', False)]}"/>
                                <span class="o_qualid_needs" attrs="{'invisible': [('qualid_app_stock', '!=', False)]}">Install Inventory</span>
                            </div>
                            <div class="o_qualid_preset">
                                <i class="fa fa-bolt" title="Automation"/>
                                <div class="o_qualid_preset_text">
                                    <b>New lead → instant reply</b>
                                    <span>When a lead with a phone number is created</span>
                                </div>
                                <button name="%(qualid_whatsapp.action_qualid_automation_wizard)d" type="action" string="Set up"
                                        context="{'default_preset': 'lead_new'}" class="btn btn-secondary btn-sm" attrs="{'invisible': [('qualid_app_crm', '=', False)]}"/>
                                <span class="o_qualid_needs" attrs="{'invisible': [('qualid_app_crm', '!=', False)]}">Install CRM</span>
                            </div>
                            <div class="o_qualid_preset">
                                <i class="fa fa-trophy" title="Automation"/>
                                <div class="o_qualid_preset_text">
                                    <b>Opportunity won → thank you</b>
                                    <span>When an opportunity reaches a Won stage</span>
                                </div>
                                <button name="%(qualid_whatsapp.action_qualid_automation_wizard)d" type="action" string="Set up"
                                        context="{'default_preset': 'lead_won'}" class="btn btn-secondary btn-sm" attrs="{'invisible': [('qualid_app_crm', '=', False)]}"/>
                                <span class="o_qualid_needs" attrs="{'invisible': [('qualid_app_crm', '!=', False)]}">Install CRM</span>
                            </div>
                            <div class="o_qualid_preset">
                                <i class="fa fa-user-plus" title="Automation"/>
                                <div class="o_qualid_preset_text">
                                    <b>New contact → welcome message</b>
                                    <span>When a contact with a phone number is created</span>
                                </div>
                                <button name="%(qualid_whatsapp.action_qualid_automation_wizard)d" type="action" string="Set up"
                                        context="{'default_preset': 'contact_welcome'}" class="btn btn-secondary btn-sm"/>
                            </div>
                            <div class="o_qualid_preset">
                                <i class="fa fa-shopping-bag" title="Automation"/>
                                <div class="o_qualid_preset_text">
                                    <b>Purchase order → send to supplier</b>
                                    <span>When a purchase order is confirmed · PDF attached</span>
                                </div>
                                <button name="%(qualid_whatsapp.action_qualid_automation_wizard)d" type="action" string="Set up"
                                        context="{'default_preset': 'po_confirmed'}" class="btn btn-secondary btn-sm" attrs="{'invisible': [('qualid_app_purchase', '=', False)]}"/>
                                <span class="o_qualid_needs" attrs="{'invisible': [('qualid_app_purchase', '!=', False)]}">Install Purchase</span>
                            </div>
                            <div class="o_qualid_preset">
                                <i class="fa fa-tasks" title="Automation"/>
                                <div class="o_qualid_preset_text">
                                    <b>Task done → notify the customer</b>
                                    <span>When a task with a customer is marked as done</span>
                                </div>
                                <button name="%(qualid_whatsapp.action_qualid_automation_wizard)d" type="action" string="Set up"
                                        context="{'default_preset': 'task_done'}" class="btn btn-secondary btn-sm" attrs="{'invisible': [('qualid_app_project', '=', False)]}"/>
                                <span class="o_qualid_needs" attrs="{'invisible': [('qualid_app_project', '!=', False)]}">Install Project</span>
                            </div>
                        </div>

                        <details class="o_qualid_more">
                            <summary>Tips: phone numbers, variables, files and troubleshooting</summary>
                            <div class="o_qualid_tips">
                                <div class="o_qualid_tip">
                                    <b><i class="fa fa-phone me-1"/>Phone number</b>
                                    Found automatically: the record's Mobile, then Phone, then its customer's.
                                    Numbers without a country code get your token's default country code.
                                </div>
                                <div class="o_qualid_tip">
                                    <b><i class="fa fa-code me-1"/>Variables</b>
                                    Each variable reads a field. Dots follow links: <code>partner_id.name</code> is the customer's name.
                                    To find a field's name, turn on developer mode and hover the field.
                                </div>
                                <div class="o_qualid_tip">
                                    <b><i class="fa fa-paperclip me-1"/>Header files</b>
                                    Image, video and document templates need a file: a PDF of the record, its latest attachment,
                                    an image from the record, or a link.
                                </div>
                                <div class="o_qualid_tip">
                                    <b><i class="fa fa-filter me-1"/>No duplicates</b>
                                    Each automation sends once per record. Marketing templates should only go to customers
                                    who agreed to receive WhatsApp messages.
                                </div>
                                <div class="o_qualid_tip">
                                    <b><i class="fa fa-pencil me-1"/>Changing an automation</b>
                                    My Automations → open the rule. Use <b>Apply on</b> to limit which records count
                                    (e.g. add <i>Type is Customer Invoice</i>), change the template,
                                    variables or file right below it, or untick <b>Active</b> to pause it.
                                </div>
                                <div class="o_qualid_tip">
                                    <b><i class="fa fa-wrench me-1"/>Build your own</b>
                                    My Automations → New → choose any model and trigger → set <b>Action To Do</b> to
                                    <b>Send WhatsApp (Quali-D)</b>. Works with any app, including custom ones.
                                </div>
                                <div class="o_qualid_tip">
                                    <b><i class="fa fa-life-ring me-1"/>Checking what happened</b>
                                    Each send leaves a note on the record. <b>Sent Messages</b> shows every message, its status and
                                    any error — failed ones can be retried.
                                </div>
                            </div>
                        </details>
                    </div>

                    <div class="o_qualid_footer">
                        Need help? <a href="https://quali-d.com" target="_blank">quali-d.com</a>
                    </div>
                </div>
            </xpath>
        </field>
    </record>

    <record id="action_qualid_settings" model="ir.actions.act_window">
        <field name="name">Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">inline</field>
        <field name="context">{'module': 'qualid_whatsapp', 'bin_size': False}</field>
    </record>
</odoo>
