<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_qualid" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.qualid</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Quali-D WhatsApp" string="Quali-D WhatsApp" name="qualid_whatsapp"
                     groups="base.group_system">
                    <block title="Connection" name="qualid_connection">
                        <setting string="Quali-D Token"
                                 help="Generate a token in Quali-D under Settings → Odoo Connector, then paste it here.">
                            <field name="qualid_api_token" password="True" placeholder="odoo_qd_…"/>
                            <div class="mt8">
                                <button name="action_qualid_test_connection" type="object"
                                        string="Test Connection" icon="fa-plug" class="btn-link"/>
                            </div>
                        </setting>
                    </block>
                    <block title="Templates" name="qualid_templates">
                        <setting string="WhatsApp Templates"
                                 help="Approved templates are copied from Quali-D so you can pick them in actions.">
                            <div class="mt8">
                                <field name="qualid_template_count" class="oe_inline" readonly="1"/> templates synchronized
                            </div>
                            <div class="mt8">
                                <button name="action_qualid_sync_templates" type="object"
                                        string="Sync Templates" icon="fa-refresh" class="btn-link"/>
                                <button name="%(qualid_whatsapp.action_qualid_template)d" type="action"
                                        string="View Templates" icon="fa-arrow-right" class="btn-link"/>
                            </div>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

    <record id="action_qualid_settings" model="ir.actions.act_window">
        <field name="name">Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">inline</field>
        <field name="context">{'module': 'qualid_whatsapp', 'bin_size': False}</field>
    </record>
</odoo>
